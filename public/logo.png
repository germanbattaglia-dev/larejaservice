=638870747756570000","imageText":"LA962_06","__typename":"Image"},"Image:158577":{"cacheId":"158577","imageId":"158577","imageLabel":"","imageTag":"","imageUrl":"https:\u002F\u002Flilianaar.vtexassets.com\u002Farquivos\u002Fids\u002F158577\u002FLA962_07.jpg?v=638870747756570000","imageText":"LA962_07","__typename":"Image"},"Image:158578":{"cacheId":"158578","imageId":"158578","imageLabel":"","imageTag":"","imageUrl":"https:\u002F\u002Flilianaar.vtexassets.com\u002Farquivos\u002Fids\u002F158578\u002FLA962_08.jpg?v=638870747756730000","imageText":"LA962_08","__typename":"Image"},"Product:sp-122-la962.items({}).0.sellers.0":{"sellerId":"1","sellerName":"Tienda Liliana Argentina","sellerDefault":true,"__typename":"Seller","commertialOffer":{"type":"id","generated":true,"id":"$Product:sp-122-la962.items({}).0.sellers.0.commertialOffer","typename":"Offer"}},"$Product:sp-122-la962.items({}).0.sellers.0.commertialOffer":{"discountHighlights":[],"teasers":[],"Price":229999,"ListPrice":259999,"Tax":0,"taxPercentage":0,"spotPrice":229999,"PriceWithoutDiscount":229999,"RewardValue":0,"PriceValidUntil":"2027-08-04T17:19:51Z","AvailableQuantity":10000,"__typename":"Offer","Installments({})":[{"type":"id","generated":true,"id":"$Product:sp-122-la962.items({}).0.sellers.0.commertialOffer.Installments({}).0","typename":"Installment"}]},"$Product:sp-122-la962.items({}).0.sellers.0.commertialOffer.Installments({}).0":{"Value":229999,"InterestRate":0,"TotalValuePlusInterestRate":229999,"NumberOfInstallments":1,"Name":"Visa à vista","PaymentSystemName":"Visa","__typename":"Installment"},"Product:sp-22-cipie2000":{"advertisement":null,"cacheId":"sp-22-cipie2000","productId":"22","description":"\u003Cp\u003E\u003Cstrong\u003ECalefactor de Pie\u002FPared Infrarrojo de Cuarzo de Liliana, modelo CIPIE2000\u003C\u002Fstrong\u003E, la soluci&oacute;n perfecta para calefaccionar espacios exteriores de manera eficiente y respetuosa con el medioambiente! Con su tecnolog&iacute;a infrarroja y tubos de cuarzo, este calefactor ofrece calor instant&aacute;neo y direccional, ideal para jardines, balcones, terrazas, quinchos, bares y restaurantes. Adem&aacute;s, su dise&ntilde;o incluye soporte de pie regulable, montaje en pared, 3 niveles de potencia y corte por ca&iacute;da para mayor seguridad. &iexcl;Disfrut&aacute; de un ambiente c&aacute;lido con la calidad y fabricaci&oacute;n argentina de Liliana!\u003C\u002Fp\u003E\n\u003Chr \u002F\u003E\n\u003Ch3\u003E\u003Cstrong\u003ECalefactor de Pie\u002FPared Infrarrojo: Calor instant&aacute;neo y vers&aacute;til\u003C\u002Fstrong\u003E\u003C\u002Fh3\u003E\n\u003Cp\u003EEste modelo est&aacute; dise&ntilde;ado para brindarte un rendimiento &oacute;ptimo, gracias a sus 3 tubos de cuarzo que emiten calor instant&aacute;neo y direccional sin desperdiciar energ&iacute;a. Con su soporte de pie regulable hasta 2 metros de altura y montaje en pared, pod&eacute;s adaptarlo a cualquier espacio exterior. &iexcl;Ideal para quienes buscan confort, ahorro energ&eacute;tico y versatilidad!\u003C\u002Fp\u003E\n\u003Chr \u002F\u003E\n\u003Ch3\u003E\u003Cstrong\u003EEspecificaciones t&eacute;cnicas y funcionalidades\u003C\u002Fstrong\u003E\u003C\u002Fh3\u003E\n\u003Cul\u003E\n\u003Cli\u003E\n\u003Cp\u003E\u003Cstrong\u003ETecnolog&iacute;a infrarroja con tubos de cuarzo\u003C\u002Fstrong\u003E: Calor instant&aacute;neo y direccional.\u003C\u002Fp\u003E\n\u003C\u002Fli\u003E\n\u003Cli\u003E\n\u003Cp\u003E\u003Cstrong\u003EPara uso en exteriores\u003C\u002Fstrong\u003E: Ideal para jardines, balcones, patios, terrazas, quinchos, bares y restaurantes.\u003C\u002Fp\u003E\n\u003C\u002Fli\u003E\n\u003Cli\u003E\n\u003Cp\u003E\u003Cstrong\u003E&Aacute;rea de cobertura m&aacute;xima\u003C\u002Fstrong\u003E:\u003C\u002Fp\u003E\n\u003Cul\u003E\n\u003Cli\u003E\n\u003Cp\u003EExterior desprotegido: 8 m&sup2;.\u003C\u002Fp\u003E\n\u003C\u002Fli\u003E\n\u003Cli\u003E\n\u003Cp\u003EExterior protegido: 12 m&sup2;.\u003C\u002Fp\u003E\n\u003C\u002Fli\u003E\n\u003C\u002Ful\u003E\n\u003C\u002Fli\u003E\n\u003Cli\u003E\n\u003Cp\u003E\u003Cstrong\u003EGrado de impermeabilidad IPX4\u003C\u002Fstrong\u003E: Protecci&oacute;n contra agua y humedad.\u003C\u002Fp\u003E\n\u003C\u002Fli\u003E\n\u003Cli\u003E\n\u003Cp\u003E\u003Cstrong\u003ECuerpo met&aacute;lico\u003C\u002Fstrong\u003E: Duradero y resistente.\u003C\u002Fp\u003E\n\u003C\u002Fli\u003E\n\u003Cli\u003E\n\u003Cp\u003E\u003Cstrong\u003E3 niveles de potencia\u003C\u002Fstrong\u003E: 650 W, 1300 W y 2000 W para mayor versatilidad.\u003C\u002Fp\u003E\n\u003C\u002Fli\u003E\n\u003Cli\u003E\n\u003Cp\u003E\u003Cstrong\u003E3 tubos de cuarzo\u003C\u002Fstrong\u003E: Calor eficiente y respetuoso con el medioambiente.\u003C\u002Fp\u003E\n\u003C\u002Fli\u003E\n\u003Cli\u003E\n\u003Cp\u003E\u003Cstrong\u003ESoporte de pie regulable\u003C\u002Fstrong\u003E: Hasta 2 metros de altura.\u003C\u002Fp\u003E\n\u003C\u002Fli\u003E\n\u003Cli\u003E\n\u003Cp\u003E\u003Cstrong\u003ESoporte para montaje en pared\u003C\u002Fstrong\u003E: Compatible con madera, metal y durlock.\u003C\u002Fp\u003E\n\u003C\u002Fli\u003E\n\u003Cli\u003E\n\u003Cp\u003E\u003Cstrong\u003ETirador colgante &ldquo;pull string&rdquo;\u003C\u002Fstrong\u003E: Encendido y cambio de potencia de f&aacute;cil accesibilidad.\u003C\u002Fp\u003E\n\u003C\u002Fli\u003E\n\u003Cli\u003E\n\u003Cp\u003E\u003Cstrong\u003EPantalla reclinable hasta 45&deg;\u003C\u002Fstrong\u003E: Ajuste de la direcci&oacute;n del calor.\u003C\u002Fp\u003E\n\u003C\u002Fli\u003E\n\u003Cli\u003E\n\u003Cp\u003E\u003Cstrong\u003ECorte por ca&iacute;da\u003C\u002Fstrong\u003E: Seguridad adicional durante el uso.\u003C\u002Fp\u003E\n\u003C\u002Fli\u003E\n\u003Cli\u003E\n\u003Cp\u003E\u003Cstrong\u003EPotencia\u003C\u002Fstrong\u003E: 650 W, 1300 W y 2000 W.\u003C\u002Fp\u003E\n\u003C\u002Fli\u003E\n\u003Cli\u003E\n\u003Cp\u003E\u003Cstrong\u003EMedidas\u003C\u002Fstrong\u003E: 59 x 59 x 212 cm (Base x Profundidad x Altura).\u003C\u002Fp\u003E\n\u003C\u002Fli\u003E\n\u003Cli\u003E\n\u003Cp\u003E\u003Cstrong\u003EIndustria argentina\u003C\u002Fstrong\u003E: Apoy&aacute;s la producci&oacute;n local.\u003C\u002Fp\u003E\n\u003C\u002Fli\u003E\n\u003C\u002Ful\u003E\n\u003Chr \u002F\u003E\n\u003Ch3\u003E\u003Cstrong\u003EGarant&iacute;a y confianza de Liliana\u003C\u002Fstrong\u003E\u003C\u002Fh3\u003E\n\u003Cp\u003EEl&nbsp;\u003Cstrong\u003ECalefactor de Pie\u002FPared Infrarrojo de Cuarzo\u003C\u002Fstrong\u003E&nbsp;de Liliana viene respaldado por una&nbsp;\u003Cstrong\u003Egarant&iacute;a de 2 a&ntilde;os\u003C\u002Fstrong\u003E, asegurando su durabilidad y rendimiento. Con la calidad y el respaldo de una marca l&iacute;der en electrodom&eacute;sticos, pod&eacute;s disfrutar de una calefacci&oacute;n eficiente y segura.\u003C\u002Fp\u003E\n\u003Chr \u002F\u003E\n\u003Ch3\u003E\u003Cstrong\u003E&iquest;Por qu&eacute; elegir el Calefactor de Pie\u002FPared Infrarrojo de Cuarzo de Liliana?\u003C\u002Fstrong\u003E\u003C\u002Fh3\u003E\n\u003Cul\u003E\n\u003Cli\u003E\n\u003Cp\u003E\u003Cstrong\u003ETecnolog&iacute;a infrarroja con tubos de cuarzo\u003C\u002Fstrong\u003E: Calor instant&aacute;neo y direccional.\u003C\u002Fp\u003E\n\u003C\u002Fli\u003E\n\u003Cli\u003E\n\u003Cp\u003E\u003Cstrong\u003EIdeal para exteriores\u003C\u002Fstrong\u003E: Jardines, balcones, terrazas, quinchos y m&aacute;s.\u003C\u002Fp\u003E\n\u003C\u002Fli\u003E\n\u003Cli\u003E\n\u003Cp\u003E\u003Cstrong\u003E3 niveles de potencia\u003C\u002Fstrong\u003E: 650 W, 1300 W y 2000 W para mayor versatilidad.\u003C\u002Fp\u003E\n\u003C\u002Fli\u003E\n\u003Cli\u003E\n\u003Cp\u003E\u003Cstrong\u003EGrado de impermeabilidad IPX4\u003C\u002Fstrong\u003E: Protecci&oacute;n contra agua y humedad.\u003C\u002Fp\u003E\n\u003C\u002Fli\u003E\n\u003Cli\u003E\n\u003Cp\u003E\u003Cstrong\u003ESoporte de pie regulable\u003C\u002Fstrong\u003E: Hasta 2 metros de altura para mayor flexibilidad.\u003C\u002Fp\u003E\n\u003C\u002Fli\u003E\n\u003Cli\u003E\n\u003Cp\u003E\u003Cstrong\u003ESoporte para montaje en pared\u003C\u002Fstrong\u003E: F&aacute;cil instalaci&oacute;n en madera, metal o durlock.\u003C\u002Fp\u003E\n\u003C\u002Fli\u003E\n\u003Cli\u003E\n\u003Cp\u003E\u003Cstrong\u003ETirador colgante &ldquo;pull string&rdquo;\u003C\u002Fstrong\u003E: Encendido y cambio de potencia de f&aacute;cil accesibilidad.\u003C\u002Fp\u003E\n\u003C\u002Fli\u003E\n\u003Cli\u003E\n\u003Cp\u003E\u003Cstrong\u003EPantalla reclinable hasta 45&deg;\u003C\u002Fstrong\u003E: Ajuste de la direcci&oacute;n del calor.\u003C\u002Fp\u003E\n\u003C\u002Fli\u003E\n\u003Cli\u003E\n\u003Cp\u003E\u003Cstrong\u003ECorte por ca&iacute;da\u003C\u002Fstrong\u003E: Seguridad adicional durante el uso.\u003C\u002Fp\u003E\n\u003C\u002Fli\u003E\n\u003Cli\u003E\n\u003Cp\u003E\u003Cstrong\u003EDise&ntilde;o moderno y duradero\u003C\u002Fstrong\u003E: Cuerpo met&aacute;lico y tubos de cuarzo.\u003C\u002Fp\u003E\n\u003C\u002Fli\u003E\n\u003Cli\u003E\n\u003Cp\u003E\u003Cstrong\u003ECompacto y pr&aacute;ctico\u003C\u002Fstrong\u003E: Ideal para cualquier espacio exterior.\u003C\u002Fp\u003E\n\u003C\u002Fli\u003E\n\u003Cli\u003E\n\u003Cp\u003E\u003Cstrong\u003EGarant&iacute;a y confianza\u003C\u002Fstrong\u003E: 2 a&ntilde;os de respaldo y fabricaci&oacute;n argentina.\u003C\u002Fp\u003E\n\u003C\u002Fli\u003E\n\u003C\u002Ful\u003E\n\u003Chr \u002F\u003E\n\u003Cp\u003ESi busc&aacute;s un calefactor vers&aacute;til, pr&aacute;ctico y eficiente, el&nbsp;\u003Cstrong\u003ECalefactor de Pie\u002FPared Infrarrojo de Cuarzo de Liliana\u003C\u002Fstrong\u003E&nbsp;es tu mejor opci&oacute;n. &iexcl;Disfrut&aacute; de un ambiente c&aacute;lido y acogedor con un equipo de calidad y fabricaci&oacute;n argentina!\u003C\u002Fp\u003E","productName":"Calefactor Infrarrojo de pie\u002Fpared con cuarzo","productReference":"CCIPIE2000","linkText":"calefactor-infrarrojo-de-piepared-con-cuarzo","brand":"Liliana","brandId":2000000,"link":"\u002Fcalefactor-infrarrojo-de-piepared-con-cuarzo\u002Fp","categories":