"},"Image:158753":{"cacheId":"158753","imageId":"158753","imageLabel":"","imageTag":"","imageUrl":"https:\u002F\u002Flilianaar.vtexassets.com\u002Farquivos\u002Fids\u002F158753\u002FCIPAR2000_03.jpg?v=638870634584070000","imageText":"CIPAR2000_03","__typename":"Image"},"Image:158754":{"cacheId":"158754","imageId":"158754","imageLabel":"","imageTag":"","imageUrl":"https:\u002F\u002Flilianaar.vtexassets.com\u002Farquivos\u002Fids\u002F158754\u002FCIPAR2000_04.jpg?v=638870634584170000","imageText":"CIPAR2000_04","__typename":"Image"},"Image:158755":{"cacheId":"158755","imageId":"158755","imageLabel":"","imageTag":"","imageUrl":"https:\u002F\u002Flilianaar.vtexassets.com\u002Farquivos\u002Fids\u002F158755\u002FCIPAR2000_05.jpg?v=638870634584230000","imageText":"CIPAR2000_05","__typename":"Image"},"Image:158756":{"cacheId":"158756","imageId":"158756","imageLabel":"","imageTag":"","imageUrl":"https:\u002F\u002Flilianaar.vtexassets.com\u002Farquivos\u002Fids\u002F158756\u002FCIPAR2000_06.jpg?v=638870634584270000","imageText":"CIPAR2000_06","__typename":"Image"},"Image:158757":{"cacheId":"158757","imageId":"158757","imageLabel":"","imageTag":"","imageUrl":"https:\u002F\u002Flilianaar.vtexassets.com\u002Farquivos\u002Fids\u002F158757\u002FCIPAR2000_07.jpg?v=638870634584330000","imageText":"CIPAR2000_07","__typename":"Image"},"Image:158758":{"cacheId":"158758","imageId":"158758","imageLabel":"","imageTag":"","imageUrl":"https:\u002F\u002Flilianaar.vtexassets.com\u002Farquivos\u002Fids\u002F158758\u002FCIPAR2000_08.jpg?v=638870634584370000","imageText":"CIPAR2000_08","__typename":"Image"},"Product:sp-20-cipar2000.items({}).0.sellers.0":{"sellerId":"1","sellerName":"Tienda Liliana Argentina","sellerDefault":true,"__typename":"Seller","commertialOffer":{"type":"id","generated":true,"id":"$Product:sp-20-cipar2000.items({}).0.sellers.0.commertialOffer","typename":"Offer"}},"$Product:sp-20-cipar2000.items({}).0.sellers.0.commertialOffer":{"discountHighlights":[],"teasers":[],"Price":79999,"ListPrice":164999,"Tax":0,"taxPercentage":0,"spotPrice":79999,"PriceWithoutDiscount":79999,"RewardValue":0,"PriceValidUntil":"2027-08-04T17:16:26Z","AvailableQuantity":10000,"__typename":"Offer","Installments({})":[{"type":"id","generated":true,"id":"$Product:sp-20-cipar2000.items({}).0.sellers.0.commertialOffer.Installments({}).0","typename":"Installment"}]},"$Product:sp-20-cipar2000.items({}).0.sellers.0.commertialOffer.Installments({}).0":{"Value":26667,"InterestRate":0,"TotalValuePlusInterestRate":79999,"NumberOfInstallments":3,"Name":"American Express 3 vezes sem juros","PaymentSystemName":"American Express","__typename":"Installment"},"Product:sp-25-ci650":{"advertisement":null,"cacheId":"sp-25-ci650","productId":"25","description":"\u003Cp\u003E\u003Cstrong\u003ECalefactor Infrarrojo Infractec - Modelo CI650\u003C\u002Fstrong\u003E\u003Cbr \u002F\u003E&iexcl;Calor eficiente y dise&ntilde;o renovado para tu hogar! El&nbsp;\u003Cstrong\u003ECalefactor Infrarrojo Infractec\u003C\u002Fstrong\u003E&nbsp;combina un&nbsp;\u003Cstrong\u003Edise&ntilde;o moderno\u003C\u002Fstrong\u003E&nbsp;con&nbsp;\u003Cstrong\u003Etecnolog&iacute;a infrarroja\u003C\u002Fstrong\u003E&nbsp;para brindar un calor confortable y seguro. Con sus&nbsp;\u003Cstrong\u003E4 tubos de cuarzo\u003C\u002Fstrong\u003E&nbsp;y sus&nbsp;\u003Cstrong\u003E2 niveles de potencia\u003C\u002Fstrong\u003E, es ideal para calefaccionar espacios medianos y grandes. Adem&aacute;s, su versatilidad permite usarlo en&nbsp;\u003Cstrong\u003Episo o pared\u003C\u002Fstrong\u003E, y su&nbsp;\u003Cstrong\u003Emanija para traslado\u003C\u002Fstrong\u003E&nbsp;lo hace f&aacute;cil de mover. &iexcl;Disfrut&aacute; del calor con la calidad de la industria argentina!\u003C\u002Fp\u003E\n\u003Chr \u002F\u003E\n\u003Ch3\u003E\u003Cstrong\u003ECalefactor Infractec: Calor infrarrojo eficiente\u003C\u002Fstrong\u003E\u003C\u002Fh3\u003E\n\u003Cp\u003EEste calefactor est&aacute; dise&ntilde;ado para ofrecer un&nbsp;\u003Cstrong\u003Ecalor directo y uniforme\u003C\u002Fstrong\u003E, sin consumir ox&iacute;geno ni resecar el ambiente. Con su&nbsp;\u003Cstrong\u003Epantalla interior met&aacute;lica\u003C\u002Fstrong\u003E&nbsp;y su&nbsp;\u003Cstrong\u003Eenrollacable integrado\u003C\u002Fstrong\u003E, es pr&aacute;ctico y funcional, ideal para uso en interiores y exteriores.\u003C\u002Fp\u003E\n\u003Chr \u002F\u003E\n\u003Ch3\u003E\u003Cstrong\u003EEspecificaciones t&eacute;cnicas y funcionalidades\u003C\u002Fstrong\u003E\u003C\u002Fh3\u003E\n\u003Cul\u003E\n\u003Cli\u003E\n\u003Cp\u003E\u003Cstrong\u003E4 tubos de cuarzo:\u003C\u002Fstrong\u003E&nbsp;Calefacci&oacute;n eficiente y duradera.\u003C\u002Fp\u003E\n\u003C\u002Fli\u003E\n\u003Cli\u003E\n\u003Cp\u003E\u003Cstrong\u003E2 niveles de potencia:\u003C\u002Fstrong\u003E&nbsp;1.000 W y 2.200 W.\u003C\u002Fp\u003E\n\u003C\u002Fli\u003E\n\u003Cli\u003E\n\u003Cp\u003E\u003Cstrong\u003EPantalla interior met&aacute;lica:\u003C\u002Fstrong\u003E&nbsp;Dise&ntilde;o robusto y seguro.\u003C\u002Fp\u003E\n\u003C\u002Fli\u003E\n\u003Cli\u003E\n\u003Cp\u003E\u003Cstrong\u003EManija para traslado:\u003C\u002Fstrong\u003E&nbsp;F&aacute;cil de mover y transportar.\u003C\u002Fp\u003E\n\u003C\u002Fli\u003E\n\u003Cli\u003E\n\u003Cp\u003E\u003Cstrong\u003EEnrollacable:\u003C\u002Fstrong\u003E&nbsp;Pr&aacute;ctico para guardar el cable.\u003C\u002Fp\u003E\n\u003C\u002Fli\u003E\n\u003Cli\u003E\n\u003Cp\u003E\u003Cstrong\u003EVersatilidad:\u003C\u002Fstrong\u003E&nbsp;Patas para uso en piso o soporte para montaje en pared.\u003C\u002Fp\u003E\n\u003C\u002Fli\u003E\n\u003Cli\u003E\n\u003Cp\u003E\u003Cstrong\u003EMedidas:\u003C\u002Fstrong\u003E&nbsp;65.5 cm (base) x 60 cm (altura) x 20 cm (profundidad).\u003C\u002Fp\u003E\n\u003C\u002Fli\u003E\n\u003C\u002Ful\u003E\n\u003Chr \u002F\u003E\n\u003Ch3\u003E\u003Cstrong\u003ETotalmente seguro\u003C\u002Fstrong\u003E\u003C\u002Fh3\u003E\n\u003Cp\u003EEl&nbsp;\u003Cstrong\u003ECalefactor Infrarrojo Infractec\u003C\u002Fstrong\u003E&nbsp;est&aacute; dise&ntilde;ado pensando en tu seguridad:\u003C\u002Fp\u003E\n\u003Cul\u003E\n\u003Cli\u003E\n\u003Cp\u003E\u003Cstrong\u003ENo consume ox&iacute;geno:\u003C\u002Fstrong\u003E&nbsp;Mantiene la calidad del aire en tu hogar.\u003C\u002Fp\u003E\n\u003C\u002Fli\u003E\n\u003Cli\u003E\n\u003Cp\u003E\u003Cstrong\u003ECorte de seguridad por ca&iacute;da:\u003C\u002Fstrong\u003E&nbsp;Protecci&oacute;n adicional en caso de volcado.\u003C\u002Fp\u003E\n\u003C\u002Fli\u003E\n\u003C\u002Ful\u003E\n\u003Chr \u002F\u003E\n\u003Ch3\u003E\u003Cstrong\u003EGarant&iacute;a y confianza\u003C\u002Fstrong\u003E\u003C\u002Fh3\u003E\n\u003Cp\u003EEste calefactor cuenta con una&nbsp;\u003Cstrong\u003Egarant&iacute;a de 2 a&ntilde;os\u003C\u002Fstrong\u003E, respaldando su durabilidad y rendimiento. Con el sello de la&nbsp;\u003Cstrong\u003Eindustria argentina\u003C\u002Fstrong\u003E, pod&eacute;s confiar en un producto de calidad y eficiencia.\u003C\u002Fp\u003E\n\u003Chr \u002F\u003E\n\u003Ch3\u003E\u003Cstrong\u003E&iquest;Por qu&eacute; elegir el Calefactor Infrarrojo Infractec?\u003C\u002Fstrong\u003E\u003C\u002Fh3\u003E\n\u003Cul\u003E\n\u003Cli\u003E\n\u003Cp\u003E\u003Cstrong\u003E4 tubos de cuarzo:\u003C\u002Fstrong\u003E&nbsp;Calor eficiente y duradero.\u003C\u002Fp\u003E\n\u003C\u002Fli\u003E\n\u003Cli\u003E\n\u003Cp\u003E\u003Cstrong\u003E2 niveles de potencia:\u003C\u002Fstrong\u003E&nbsp;Adaptable a tus necesidades (1.000 W y 2.200 W).\u003C\u002Fp\u003E\n\u003C\u002Fli\u003E\n\u003Cli\u003E\n\u003Cp\u003E\u003Cstrong\u003EDise&ntilde;o renovado:\u003C\u002Fstrong\u003E&nbsp;Moderno y funcional.\u003C\u002Fp\u003E\n\u003C\u002Fli\u003E\n\u003Cli\u003E\n\u003Cp\u003E\u003Cstrong\u003EVersatilidad:\u003C\u002Fstrong\u003E&nbsp;Uso en piso o pared.\u003C\u002Fp\u003E\n\u003C\u002Fli\u003E\n\u003Cli\u003E\n\u003Cp\u003E\u003Cstrong\u003EManija para traslado:\u003C\u002Fstrong\u003E&nbsp;F&aacute;cil de mover.\u003C\u002Fp\u003E\n\u003C\u002Fli\u003E\n\u003Cli\u003E\n\u003Cp\u003E\u003Cstrong\u003ESeguridad avanzada:\u003C\u002Fstrong\u003E&nbsp;No consume ox&iacute;geno y tiene corte por ca&iacute;da.\u003C\u002Fp\u003E\n\u003C\u002Fli\u003E\n\u003Cli\u003E\n\u003Cp\u003E\u003Cstrong\u003EGarant&iacute;a de 2 a&ntilde;os:\u003C\u002Fstrong\u003E&nbsp;Confianza y respaldo.\u003C\u002Fp\u003E\n\u003C\u002Fli\u003E\n\u003C\u002Ful\u003E\n\u003Chr \u002F\u003E\n\u003Cp\u003ESi busc&aacute;s un calefactor&nbsp;\u003Cstrong\u003Eeficiente, vers&aacute;til y seguro\u003C\u002Fstrong\u003E, el&nbsp;\u003Cstrong\u003ECalefactor Infrarrojo Infractec - Modelo CI650\u003C\u002Fstrong\u003E&nbsp;es tu mejor opci&oacute;n. &iexcl;Disfrut&aacute; del calor en espacios medianos y grandes con un producto de calidad argentina!\u003C\u002Fp\u003E","productName":"Calefactor Infrarrojo Infractec","productReference":"CCCI650","linkText":"calefactor-infrarrojo-infractec","brand":"Liliana","brandId":2000000,"link":"\u002Fcalefactor-infrarrojo-infractec\u002Fp","categories":{"type":"json","json":["\u002FCalefacción\u002FInfrarrojos\u002F","\u002FCalefacción\u002F"]},"categoryId":"13","releaseDate":"1752710400000","priceRange":{"type":"id","generated":true,"id":"$Product:sp-25-ci650.priceRange","typename":"ProductPriceRange"},"specificationGroups":[{"type":"id","generated":true,"id":"Product:sp-25-ci650.specificationGroups.0","typename":"SpecificationGroup"},{"type":"id","generated":true,"id":"Product:sp-25-ci650.specificationGroups.1","typename":"SpecificationGroup"}],"skuSpecifications":[],"productClusters":[{"type":"id","generated":true,"id":"Product:sp-25-ci650.productClusters.0","typename":"ProductClusters"},{"type":"id","generated":true,"id":"Product:sp-25-ci650.productClusters.1","typename":"ProductClusters"},{"type":"id","generated":true,"id":"Product:sp-25-ci650.productClusters.2","typename":"ProductClusters"},{"type":"id","generated":true,"id":"Product:sp-25-ci650.productClusters.3","typename":"ProductClusters"},{"type