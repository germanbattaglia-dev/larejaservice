":"id","generated":true,"id":"$Product:sp-404-ab917.items({}).0.sellers.0.commertialOffer.Installments({}).0","typename":"Installment"}]},"$Product:sp-404-ab917.items({}).0.sellers.0.commertialOffer.Installments({}).0":{"Value":229990,"InterestRate":0,"TotalValuePlusInterestRate":229990,"NumberOfInstallments":1,"Name":"Visa à vista","PaymentSystemName":"Visa","__typename":"Installment"},"Product:sp-305-aap990n":{"advertisement":null,"cacheId":"sp-305-aap990n","productId":"305","description":"\u003Ch3\u003E\u003Cstrong\u003EPava Eléctrica Liliana Retrostyle AP990N – Diseño Vintage y Tecnología Moderna\u003C\u002Fstrong\u003E\u003C\u002Fh3\u003E\u003Cbr\u002F\u003E\u003Cstrong\u003EElegancia retro, eficiencia total.\u003C\u002Fstrong\u003E La \u003Cstrong\u003Epava eléctrica Retrostyle de Liliana\u003C\u002Fstrong\u003E combina un diseño vintage único con tecnología de última generación. Ideal para quienes aman el estilo sin renunciar a la funcionalidad, esta pava de \u003Cstrong\u003Eacero inoxidable con termómetro\u003C\u002Fstrong\u003E es perfecta para preparar té, café o mate en segundos.\u003Ch4\u003E\u003Cbr\u002F\u003E\u003Cstrong\u003ECaracterísticas destacadas:\u003C\u002Fstrong\u003E\u003C\u002Fh4\u003E\u003Cul\u003E\u003Cli\u003E\u003Cstrong\u003ECuerpo de acero inoxidable\u003C\u002Fstrong\u003E: resistente, duradero y fácil de limpiar.\u003C\u002Fli\u003E\u003Cli\u003E\u003Cstrong\u003ECapacidad de 1,7 litros\u003C\u002Fstrong\u003E, ideal para toda la familia.\u003C\u002Fli\u003E\u003Cli\u003E\u003Cstrong\u003EPotencia de 2.000 watts\u003C\u002Fstrong\u003E para un hervor rápido y eficiente.\u003C\u002Fli\u003E\u003Cli\u003E\u003Cstrong\u003ETermómetro incorporado\u003C\u002Fstrong\u003E para controlar la temperatura ideal en cada infusión.\u003C\u002Fli\u003E\u003Cli\u003E\u003Cstrong\u003EVisor de nivel de agua\u003C\u002Fstrong\u003E para una carga precisa.\u003C\u002Fli\u003E\u003C\u002Ful\u003E\u003Ch4\u003E\u003Cbr\u002F\u003E\u003Cstrong\u003EMáxima seguridad y comodidad:\u003C\u002Fstrong\u003E\u003C\u002Fh4\u003E\u003Cul\u003E\u003Cli\u003E\u003Cstrong\u003ECorte automático al hervir\u003C\u002Fstrong\u003E y \u003Cstrong\u003Eprotección contra sobrecalentamiento\u003C\u002Fstrong\u003E.\u003C\u002Fli\u003E\u003Cli\u003E\u003Cstrong\u003ETapa con traba de seguridad\u003C\u002Fstrong\u003E y sistema de apertura fácil.\u003C\u002Fli\u003E\u003Cli\u003E\u003Cstrong\u003EBase 360º antideslizante\u003C\u002Fstrong\u003E con enrollacable, práctica para zurdos y diestros.\u003C\u002Fli\u003E\u003Cli\u003E\u003Cstrong\u003ELuz indicadora de encendido\u003C\u002Fstrong\u003E y botón ON\u002FOFF intuitivo.\u003C\u002Fli\u003E\u003C\u002Ful\u003E\u003Ch4\u003E\u003Cbr\u002F\u003E\u003Cstrong\u003EDiseño retro con estilo:\u003C\u002Fstrong\u003E\u003C\u002Fh4\u003EDisponible en tres elegantes colores: \u003Cstrong\u003ECrema, Rojo y Negro\u003C\u002Fstrong\u003E.\u003Cbr\u002F\u003E Ideal para complementar cocinas modernas o clásicas con un \u003Cstrong\u003Etoque vintage y sofisticado\u003C\u002Fstrong\u003E.\u003Ch4\u003E\u003Cbr\u002F\u003E\u003Cstrong\u003EGarantía oficial Liliana: 2 años\u003C\u002Fstrong\u003E\u003C\u002Fh4\u003E","productName":"Pava Electrica RetroStyle Negra AP990N","productReference":"AAP990N","linkText":"pava-electrica-retrostyle-negra-1","brand":"Liliana","brandId":2000000,"link":"\u002Fpava-electrica-retrostyle-negra-1\u002Fp","categories":{"type":"json","json":["\u002FDesayuno\u002FPavas\u002F","\u002FDesayuno\u002F"]},"categoryId":"40","releaseDate":"1752710400000","priceRange":{"type":"id","generated":true,"id":"$Product:sp-305-aap990n.priceRange","typename":"ProductPriceRange"},"specificationGroups":[{"type":"id","generated":true,"id":"Product:sp-305-aap990n.specificationGroups.0","typename":"SpecificationGroup"},{"type":"id","generated":true,"id":"Product:sp-305-aap990n.specificationGroups.1","typename":"SpecificationGroup"}],"skuSpecifications":[],"productClusters":[{"type":"id","ge