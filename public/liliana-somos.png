<script type="0d608ef3eab2c1cebc3f69f4-text/javascript">











$(function() {



  $(document).foundation({



    equalizer: {



        equalize_on_stack: true



    }



});



});



$(document).ready(function () {



$('.mobilemenu').click(function (e) {



    $('body').toggleClass('menuopen');



    e.preventDefault();



});







 function parallax() {



    



    if ($(window).width() > 800) {



         var scrollTop = $(window).scrollTop();



        $('.parallax').each(function () {



            var pos = $(this).offset();







            if ($(window).height() > 1000 && $(this).data('offset-big') ) {



              var off = $(this).data('offset-big');



            } else {



              var off = $(this).data('offset');



            }



            var speed = $(this).data('speed');



            var offset = pos.top - scrollTop + off;



            $(this).css('background-position', 'center '+Math.round(offset*speed)+'px');







        }); 



    }







    



}



$(window).scroll(function () { 



    parallax(); 



});



parallax();







setTimeout(function() { $('.pageheader, #homeslider').addClass('in'); },200);



setTimeout(function() { $('.pageheader h2, .pageheader h3').addClass('in'); },500);



setTimeout(function() { $('.page').addClass('in'); },800);







var t = 0;



$('.producto').each(function() {



	t++;



	var p = this;



	setTimeout(function() { $(p).addClass('in'); },t*300);	



});











setTimeout(function() { $('.grilla').addClass('in'); },800);



/*



$('.grilla').waypoint(function(direction) {



	



}, { offset: '-50%' });



*/



$(document).foundation('equalizer', 'reflow');







});



</script> 







