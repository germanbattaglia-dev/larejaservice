<script type="0d608ef3eab2c1cebc3f69f4-text/javascript">



$(document).ready(function () {



$('.checkbox input').change(function() {



	console.log($(this).is(':checked'));



	if ($(this).is(':checked')) {



		$(this).parent().addClass('checked');



	} else {



		$(this).parent().removeClass('checked');



	}



});







$('#newsletter').on('valid', function (e) {



    



    $('#newsletter .button').addClass('disabled').attr('disabled','disabled');







    $.post("https://www.somosliliana.com.ar/", 



        {



            nombre: $('input[name="nombre"]').val(),



            email: $('input[name="email"]').val(),



            edad: $('[name="edad"]').val(),



            sexo: $('[name="sexo"]').val(),



            localidad: $('[name="localidad"]').val(),



            action: 'subscribe'



        },



        function(data){



            console.log(data); //  2pm







            if (data == 1) {



                	$('.message').html('Te haz subscripto al newsteller. Gracias!').fadeIn(300); 



                	$('.button').fadeOut();



            }







            if (data == 2) {



                	$('.message').html('El email ingresado ya existe en nuestra base de datos').fadeIn(300); 



                	$('#newsletter .button').removeClass('disabled').removeAttr('disabled');



            }



            	



             



        }



    );



    e.preventDefault();







});







});



</script>











