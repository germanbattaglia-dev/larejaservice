<script type="0d608ef3eab2c1cebc3f69f4-text/javascript">

$(document).ready(function () {



$('nav.productos>ul>li ul a').click(function(e) {

  if ($(this).attr('href') == '#')   {

    e.preventDefault();  

    $(this).next().fadeIn();

    $('.submenubg a').fadeIn();

  } else {

    return true;

  }

});

$('.submenubg a').click(function(e) {

  $(this).fadeOut();

  $('nav.productos>ul>li ul ul').fadeOut();

  e.preventDefault();

});



$('nav.productos>ul>li>a').click(function(e) {

  $('body').toggleClass('submenuabierto');

  $(this).parent().toggleClass('active');

  e.preventDefault();

});

$('.busqueda .ico').click(function(e) {

  $('body').removeClass('submenuabierto');

  $('nav.productos>ul>li').removeClass('active');

  $('body').toggleClass('buscadorabierto');

  setTimeout(function(){

      $('#busquedainput').focus();

  }, 501);

  e.preventDefault();

});

$('.busqueda .cerrar').click(function(e) {

  $('body').toggleClass('buscadorabierto');

  e.preventDefault();

});



$('#busquedainput').keyup(function () {

    if ($(this).val().length > 2) {



      $('#busquedainput').addClass('loading');



      var search = $(this).val();

      $.post("https://www.somosliliana.com.ar/index.php?s="+search,

        function(data){      

          $('#results').html(data);

          $('#results').fadeIn();

          $('#busquedainput').removeClass('loading');

        }

            );



    } else {

      $('#results').fadeOut();

    }



  });





$('#busquedainput2').keyup(function () {

    if ($(this).val().length > 2) {



      $('#busquedainput2').addClass('loading');



      var search = $(this).val();

      $.post("https://www.somosliliana.com.ar/index.php?s="+search,

        function(data){      

          $('#results2').html(data);

          $('#results2').fadeIn();

          $('#busquedainput2').removeClass('loading');

        }

            );



    } else {

      $('#results2').fadeOut();

    }



  });



});

</script>

